@model Movies
<h1>Movie Form</h1>
<form method="POST">

    <input type="hidden" asp-for="MovieId"/>
    
    <label asp-for="Title">Title</label>
    <input asp-for="Title" />

    <br />
    <label asp-for="CategoryId">Genre</label>
    <select asp-for="CategoryId" asp-items="@(new SelectList(ViewBag.Genres, "CategoryId", "CategoryName"))">
        <option value="">Select a Genre</option>
    </select>
    <span asp-validation-for="CategoryId" class="text-danger"></span>

    <br />
    <label asp-for="Year">Year</label>
    <input asp-for="Year" />
    <br />
    <label asp-for="Director">Director</label>
    <input asp-for="Director" />
    <br />
    <label asp-for="Rating">Rating</label>
    <select asp-for="Rating">
        <option value="">Select a Rating</option>
        <option>G</option>
        <option>PG</option>
        <option>PG-13</option>
        <option>R</option>
    </select>
    <br />
    <label asp-for="Edited">Edited</label>
    <select asp-for="Edited">
        <option value="true">Yes</option>
        <option value="false">No</option>
    </select>
    <br />
    <label asp-for="LentTo">Lent to</label>
    <input asp-for="LentTo" />
    <br />
    
    <label asp-for="CopiedToPlex">CopiedToPlex</label>
    <select asp-for="CopiedToPlex">
        <option value="true">Yes</option>
        <option value="false">No</option>
    </select>
    <br />
    <label asp-for ="Notes">Notes</label>
    <input asp-for="Notes" />

    <button type="submit">Submit Movie</button>

    <div asp-validation-summary="All"></div>
</form>